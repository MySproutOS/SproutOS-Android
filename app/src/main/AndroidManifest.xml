<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Installing another app is the whole point of this one, and it is a permission the user is
      asked about at the moment it is first used rather than granted at install. Declaring it does
      not grant it.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.SproutOS"
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Where the browser sends the sign-in back to.

              A custom scheme, which any app can also claim — so the `state` check in `Auth.kt` is
              what actually establishes that a callback came from the flow this app started, not
              the fact that Android delivered it here. `singleTask` so returning from the browser
              resumes the running activity rather than stacking a second copy behind it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sproutos" android:host="auth" />
            </intent-filter>
        </activity>

        <!--
          Downloaded APKs live in this app's own cache and are handed to the installer through a
          content URI. A `file://` URI has been rejected since Android 7 with a
          FileUriExposedException, and the provider is what makes the handover legal.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
