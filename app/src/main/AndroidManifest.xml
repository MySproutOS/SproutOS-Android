<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Installing another app is the whole point of this one, and it is a permission the user is
      asked about at the moment it is first used rather than granted at install. Declaring it does
      not grant it.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      Android 12+ can honor a PackageInstaller request to update without a confirmation screen,
      but only for self-updates or installer-of-record/update-owner updates which also meet the
      platform's moving target-SDK floor. This normal permission merely lets Android evaluate the
      request; it does not bypass any of those checks.
    -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- Confirmation fallback notifications are opt-in at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11 filters package-manager lookups unless the caller declares what it needs to see.
      Every installable SproutOS project has a launcher activity, but its generated package name is
      not known when this APK is built, so an intent query is the narrow alternative to the broad
      QUERY_ALL_PACKAGES permission. Without this, getPackageInfo() reports a deployed app as not
      installed and the client cannot enforce its own signer/downgrade checks or offer Open.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SproutOS"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Where the browser sends the sign-in back to.

              A custom scheme, which any app can also claim — so the `state` check in `Auth.kt` is
              what actually establishes that a callback came from the flow this app started, not
              the fact that Android delivered it here. `singleTask` so returning from the browser
              resumes the running activity rather than stacking a second copy behind it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sproutos" android:host="auth" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

    </application>
</manifest>
