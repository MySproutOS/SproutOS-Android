<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 can perform device-to-device transfer even when allowBackup is false. The encrypted
  OAuth session must not move: its Android Keystore key does not move with it, so restoring only
  the encrypted preferences both gains nothing and can make the restored client unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
